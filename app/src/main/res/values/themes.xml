<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- All UI is drawn with Jetpack Compose; this theme only styles the window
         before the first frame so there is no white/black flash. -->
    <style name="Theme.Motalee" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
